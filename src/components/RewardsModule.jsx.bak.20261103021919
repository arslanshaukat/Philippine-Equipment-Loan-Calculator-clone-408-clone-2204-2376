import React, { useEffect, useState, useCallback } from 'react';
import pb from '../supabase/supabase';
import { FiSettings, FiPlus, FiTrash2, FiRotateCcw, FiGift, FiCheck, FiX, FiTrendingUp } from 'react-icons/fi';
import SafeIcon from '../common/SafeIcon';

const peso = (n) => '₱' + new Intl.NumberFormat().format(n || 0);

const RewardsModule = () => {
  const [tab, setTab] = useState('allocate'); // allocate | ledger | redemptions | paymentlog | reports | rules | settings
  const [staff, setStaff] = useState([]);
  const [rules, setRules] = useState([]);
  const [settings, setSettings] = useState(null);
  const [ledger, setLedger] = useState([]);
  const [redemptions, setRedemptions] = useState([]);
  const [loading, setLoading] = useState(true);

  const load = useCallback(async () => {
    setLoading(true);
    try {
      const [staffRes, rulesRes, settingsRes, ledgerRes, redemptionsRes] = await Promise.all([
        pb.collection('users').getFullList({ sort: 'name', filter: 'active = true' }),
        pb.collection('reward_rules').getFullList({ sort: 'event_type' }),
        pb.collection('reward_settings').getFullList({ filter: 'active = true' }),
        pb.collection('reward_points').getFullList({ sort: '-created', expand: 'staff,awarded_by,rule' }),
        pb.collection('reward_redemptions').getFullList({ sort: '-created', expand: 'staff,approved_by' }),
      ]);
      setStaff(staffRes);
      setRules(rulesRes);
      setSettings(settingsRes[0] || null);
      setLedger(ledgerRes);
      setRedemptions(redemptionsRes);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  const pendingCount = redemptions.filter(r => r.status === 'pending').length;

  return (
    <div className="max-w-4xl mx-auto">
      <div className="flex items-center justify-between mb-6 flex-wrap gap-3">
        <h2 className="font-black text-gray-800 flex items-center gap-3 uppercase text-xs tracking-widest">
          <div className="w-1 h-4 bg-blue-600 rounded-full" /> Rewards
        </h2>
        <div className="flex gap-1 bg-white p-1 rounded-2xl border border-gray-100 shadow-sm flex-wrap">
          {[
            ['allocate', 'Allocate'],
            ['ledger', 'Ledger'],
            ['redemptions', `Redemptions${pendingCount ? ` (${pendingCount})` : ''}`],
            ['paymentlog', 'Payment Log'],
            ['reports', 'Reports'],
            ['rules', 'Rules'],
            ['settings', 'Settings'],
          ].map(([key, label]) => (
            <button
              key={key}
              onClick={() => setTab(key)}
              className={`px-3.5 py-2 rounded-xl text-[9px] font-black uppercase tracking-widest ${
                tab === key ? 'bg-blue-700 text-white' : 'text-gray-500 hover:bg-gray-50'
              }`}
            >
              {label}
            </button>
          ))}
        </div>
      </div>

      {loading ? (
        <div className="p-10 text-center text-[10px] font-black uppercase tracking-widest text-gray-400">Loading…</div>
      ) : (
        <>
          {tab === 'allocate' && (
            <AllocateTab staff={staff} rules={rules} settings={settings} onDone={load} />
          )}
          {tab === 'ledger' && <LedgerTab ledger={ledger} settings={settings} onReverse={load} />}
          {tab === 'redemptions' && <RedemptionsTab redemptions={redemptions} settings={settings} onChange={load} />}
          {tab === 'paymentlog' && <PaymentLogTab redemptions={redemptions} />}
          {tab === 'reports' && <ReportsTab ledger={ledger} redemptions={redemptions} staff={staff} settings={settings} />}
          {tab === 'rules' && <RulesTab rules={rules} onChange={load} />}
          {tab === 'settings' && <SettingsTab settings={settings} onChange={load} />}
        </>
      )}
    </div>
  );
};

// ---------- Allocate ----------
const AllocateTab = ({ staff, rules, settings, onDone }) => {
  const [staffId, setStaffId] = useState('');
  const [ruleId, setRuleId] = useState('');
  const [points, setPoints] = useState('');
  const [reason, setReason] = useState('');
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');

  const handleRuleSelect = (id) => {
    setRuleId(id);
    const rule = rules.find((r) => r.id === id);
    if (rule) setPoints(String(rule.default_points));
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setSuccess('');
    if (!staffId || !points) {
      setError('Select a staff member and enter points.');
      return;
    }
    setSubmitting(true);
    try {
      await pb.collection('reward_points').create({
        staff: staffId,
        points: Number(points),
        reason,
        rule: ruleId || null,
        awarded_by: pb.authStore.model?.id,
        status: 'active',
      });
      setSuccess('Points allocated.');
      setStaffId(''); setRuleId(''); setPoints(''); setReason('');
      onDone?.();
    } catch (err) {
      setError(err?.data?.message || err.message || 'Failed to allocate points.');
    } finally {
      setSubmitting(false);
    }
  };

  const pesoPerPoint = settings?.peso_per_point || 5000;
  const pesoValue = points ? Number(points) * pesoPerPoint : 0;

  return (
    <form onSubmit={handleSubmit} className="bg-white rounded-[32px] border border-gray-100 shadow-sm p-6 space-y-4 max-w-lg">
      <div>
        <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Staff Member</label>
        <select required value={staffId} onChange={(e) => setStaffId(e.target.value)}
          className="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-200">
          <option value="">Select staff…</option>
          {staff.map((s) => <option key={s.id} value={s.id}>{s.name || s.email}</option>)}
        </select>
      </div>

      <div>
        <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Event / Rule (optional)</label>
        <select value={ruleId} onChange={(e) => handleRuleSelect(e.target.value)}
          className="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-200">
          <option value="">Custom (no rule)</option>
          {rules.filter(r => r.active).map((r) => (
            <option key={r.id} value={r.id}>{r.event_type} (+{r.default_points} pts)</option>
          ))}
        </select>
      </div>

      <div>
        <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Points</label>
        <input required type="number" step="0.5" value={points} onChange={(e) => setPoints(e.target.value)}
          className="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-200" />
        {points && (
          <p className="text-[10px] font-bold text-blue-600 mt-1">≈ {peso(pesoValue)}</p>
        )}
      </div>

      <div>
        <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Reason</label>
        <textarea value={reason} onChange={(e) => setReason(e.target.value)} rows={2}
          placeholder="e.g. Closed unit sale for Isuzu Forward, Job #124"
          className="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-200 resize-none" />
      </div>

      {error && <div className="text-[10px] font-black text-red-600 uppercase bg-red-50 border border-red-100 rounded-xl px-4 py-3">{error}</div>}
      {success && <div className="text-[10px] font-black text-green-600 uppercase bg-green-50 border border-green-100 rounded-xl px-4 py-3">{success}</div>}

      <button type="submit" disabled={submitting}
        className="w-full bg-blue-700 text-white font-black text-[10px] uppercase tracking-widest py-3.5 rounded-xl flex items-center justify-center gap-2 disabled:opacity-60">
        <SafeIcon icon={FiGift} /> {submitting ? 'Allocating…' : 'Allocate Points'}
      </button>
    </form>
  );
};

// ---------- Ledger ----------
const LedgerTab = ({ ledger, settings, onReverse }) => {
  const pesoPerPoint = settings?.peso_per_point || 5000;

  const handleReverse = async (entry) => {
    if (!confirm(`Reverse ${entry.points} pts for ${entry.expand?.staff?.name || 'this staff member'}?`)) return;
    await pb.collection('reward_points').create({
      staff: entry.staff,
      points: -entry.points,
      reason: `Reversal of: ${entry.reason || 'entry ' + entry.id}`,
      awarded_by: pb.authStore.model?.id,
      status: 'active',
    });
    await pb.collection('reward_points').update(entry.id, { status: 'reversed' });
    onReverse?.();
  };

  const balances = {};
  for (const e of [...ledger].reverse()) {
    if (e.status === 'reversed') continue;
    balances[e.staff] = (balances[e.staff] || 0) + e.points;
  }

  return (
    <div className="space-y-6">
      {Object.keys(balances).length > 0 && (
        <div className="bg-white rounded-[32px] border border-gray-100 shadow-sm p-6">
          <h3 className="text-[9px] font-black text-gray-400 uppercase tracking-widest mb-4">Current Balances (earned, before redemptions)</h3>
          <div className="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
            {Object.entries(balances).map(([staffId, total]) => {
              const entry = ledger.find(e => e.staff === staffId);
              const name = entry?.expand?.staff?.name || entry?.expand?.staff?.email || 'Unknown';
              return (
                <div key={staffId} className="bg-gray-50 border border-gray-100 rounded-2xl p-4">
                  <div className="font-black text-gray-900 uppercase text-xs">{name}</div>
                  <div className="text-blue-700 font-black text-lg mt-1">{total} pts</div>
                  <div className="text-[10px] text-gray-400 font-bold">{peso(total * pesoPerPoint)}</div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <div className="bg-white rounded-[32px] border border-gray-100 shadow-sm divide-y divide-gray-50 overflow-hidden">
        {ledger.length === 0 ? (
          <div className="p-10 text-center text-[10px] font-black uppercase tracking-widest text-gray-400">No entries yet.</div>
        ) : ledger.map((entry) => (
          <div key={entry.id} className={`p-5 flex items-center justify-between gap-4 flex-wrap ${entry.status === 'reversed' ? 'opacity-40' : ''}`}>
            <div>
              <div className="flex items-center gap-2 flex-wrap">
                <span className="font-black text-gray-900 uppercase text-sm">
                  {entry.expand?.staff?.name || entry.expand?.staff?.email || 'Unknown'}
                </span>
                <span className={`text-[10px] font-black ${entry.points >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                  {entry.points >= 0 ? '+' : ''}{entry.points} pts
                </span>
                {entry.status === 'reversed' && (
                  <span className="text-[8px] px-2 py-0.5 rounded-full font-black uppercase bg-gray-100 text-gray-500">Reversed</span>
                )}
              </div>
              <div className="text-[10px] text-gray-400 font-bold mt-0.5">
                {entry.reason || (entry.expand?.rule?.event_type ?? 'No reason given')} · by {entry.expand?.awarded_by?.name || 'admin'}
              </div>
            </div>
            {entry.status !== 'reversed' && (
              <button onClick={() => handleReverse(entry)}
                className="p-2.5 rounded-xl bg-gray-50 text-gray-500 border" title="Reverse this entry">
                <SafeIcon icon={FiRotateCcw} />
              </button>
            )}
          </div>
        ))}
      </div>
    </div>
  );
};

// ---------- Redemptions ----------
const RedemptionsTab = ({ redemptions, settings, onChange }) => {
  const currentUserId = pb.authStore.model?.id;
  const [payingId, setPayingId] = useState(null);
  const [paidDate, setPaidDate] = useState('');
  const [paymentRef, setPaymentRef] = useState('');

  const setStatus = async (r, status) => {
    const updates = { status };
    if (status === 'approved') updates.approved_by = currentUserId;
    await pb.collection('reward_redemptions').update(r.id, updates);
    onChange?.();
  };

  const startMarkPaid = (r) => {
    setPayingId(r.id);
    setPaidDate(new Date().toISOString().slice(0, 10));
    setPaymentRef('');
  };

  const confirmMarkPaid = async (r) => {
    await pb.collection('reward_redemptions').update(r.id, {
      status: 'paid',
      paid_date: paidDate,
      payment_reference: paymentRef,
    });
    setPayingId(null);
    onChange?.();
  };

  const statusColor = (status) => ({
    pending: 'bg-amber-50 text-amber-600 border-amber-200',
    approved: 'bg-blue-50 text-blue-600 border-blue-200',
    paid: 'bg-green-50 text-green-600 border-green-200',
    rejected: 'bg-red-50 text-red-600 border-red-200',
  }[status] || 'bg-gray-50 text-gray-500 border-gray-200');

  return (
    <div className="bg-white rounded-[32px] border border-gray-100 shadow-sm divide-y divide-gray-50 overflow-hidden">
      {redemptions.length === 0 ? (
        <div className="p-10 text-center text-[10px] font-black uppercase tracking-widest text-gray-400">No redemption requests yet.</div>
      ) : redemptions.map((r) => (
        <div key={r.id} className="p-5 flex flex-col gap-3">
          <div className="flex items-center justify-between gap-4 flex-wrap">
            <div>
              <div className="flex items-center gap-2 flex-wrap">
                <span className="font-black text-gray-900 uppercase text-sm">{r.expand?.staff?.name || r.expand?.staff?.email || 'Unknown'}</span>
                <span className={`text-[8px] px-2 py-0.5 rounded-full font-black uppercase border ${statusColor(r.status)}`}>{r.status}</span>
              </div>
              <div className="text-[10px] text-gray-400 font-bold mt-0.5">
                {r.points_used} pts · {peso(r.peso_value)} · {r.redemption_type.replace('_', ' ')}
                {r.notes && <> · "{r.notes}"</>}
              </div>
              <div className="text-[9px] text-gray-300 font-bold mt-0.5">
                Requested {new Date(r.created).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' })}
                {r.expand?.approved_by && <> · approved by {r.expand.approved_by.name}</>}
                {r.status === 'paid' && r.paid_date && (
                  <> · paid {new Date(r.paid_date).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' })}{r.payment_reference && ` (${r.payment_reference})`}</>
                )}
              </div>
            </div>
            <div className="flex gap-2 shrink-0">
              {r.status === 'pending' && (
                <>
                  <button onClick={() => setStatus(r, 'approved')} className="p-2.5 rounded-xl bg-blue-50 text-blue-600 border border-blue-100" title="Approve">
                    <SafeIcon icon={FiCheck} />
                  </button>
                  <button onClick={() => setStatus(r, 'rejected')} className="p-2.5 rounded-xl bg-red-50 text-red-500 border border-red-100" title="Reject">
                    <SafeIcon icon={FiX} />
                  </button>
                </>
              )}
              {r.status === 'approved' && payingId !== r.id && (
                <button onClick={() => startMarkPaid(r)} className="px-3 py-2.5 rounded-xl bg-green-50 text-green-600 border border-green-100 text-[9px] font-black uppercase">
                  Mark Paid
                </button>
              )}
            </div>
          </div>

          {payingId === r.id && (
            <div className="bg-gray-50 rounded-2xl p-4 flex flex-wrap gap-3 items-end">
              <div>
                <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Paid Date</label>
                <input type="date" value={paidDate} onChange={(e) => setPaidDate(e.target.value)}
                  className="px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm font-bold outline-none" />
              </div>
              <div className="flex-1 min-w-[180px]">
                <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Payment Reference</label>
                <input value={paymentRef} onChange={(e) => setPaymentRef(e.target.value)} placeholder="e.g. 2026 13th Month Bonus"
                  className="w-full px-3 py-2 bg-white border border-gray-200 rounded-xl text-sm font-bold outline-none" />
              </div>
              <button onClick={() => confirmMarkPaid(r)} className="px-4 py-2.5 rounded-xl bg-green-600 text-white text-[9px] font-black uppercase">
                Confirm Paid
              </button>
              <button onClick={() => setPayingId(null)} className="px-4 py-2.5 rounded-xl bg-gray-100 text-gray-500 text-[9px] font-black uppercase">
                Cancel
              </button>
            </div>
          )}
        </div>
      ))}
    </div>
  );
};

// ---------- Payment Log ----------
const PaymentLogTab = ({ redemptions }) => {
  const paid = redemptions.filter((r) => r.status === 'paid');

  const byYear = {};
  for (const r of paid) {
    const year = r.paid_date ? new Date(r.paid_date).getFullYear() : new Date(r.created).getFullYear();
    byYear[year] = byYear[year] || [];
    byYear[year].push(r);
  }
  const years = Object.keys(byYear).sort((a, b) => b - a);

  return (
    <div className="space-y-6">
      {years.length === 0 ? (
        <div className="bg-white rounded-[32px] border border-gray-100 shadow-sm p-10 text-center text-[10px] font-black uppercase tracking-widest text-gray-400">
          No payments logged yet.
        </div>
      ) : years.map((year) => {
        const entries = byYear[year];
        const totalPeso = entries.reduce((sum, r) => sum + r.peso_value, 0);
        const totalPoints = entries.reduce((sum, r) => sum + r.points_used, 0);
        return (
          <div key={year} className="bg-white rounded-[32px] border border-gray-100 shadow-sm overflow-hidden">
            <div className="p-6 border-b bg-gray-50/50 flex items-center justify-between flex-wrap gap-2">
              <h3 className="font-black text-gray-800 uppercase text-sm">{year}</h3>
              <div className="text-[10px] font-bold text-gray-500">
                {entries.length} payment{entries.length === 1 ? '' : 's'} · {totalPoints} pts · {peso(totalPeso)} total
              </div>
            </div>
            <div className="divide-y divide-gray-50">
              {entries
                .sort((a, b) => new Date(b.paid_date || b.created) - new Date(a.paid_date || a.created))
                .map((r) => (
                  <div key={r.id} className="p-5 flex items-center justify-between gap-4 flex-wrap">
                    <div>
                      <span className="font-black text-gray-900 uppercase text-sm">{r.expand?.staff?.name || r.expand?.staff?.email || 'Unknown'}</span>
                      <div className="text-[10px] text-gray-400 font-bold mt-0.5">
                        {r.points_used} pts · {peso(r.peso_value)}
                        {r.payment_reference && <> · {r.payment_reference}</>}
                      </div>
                    </div>
                    <div className="text-[10px] text-gray-400 font-bold">
                      {r.paid_date
                        ? new Date(r.paid_date).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' })
                        : '—'}
                    </div>
                  </div>
                ))}
            </div>
          </div>
        );
      })}
    </div>
  );
};

// ---------- Reports ----------
const ReportsTab = ({ ledger, redemptions, staff, settings }) => {
  const pesoPerPoint = settings?.peso_per_point || 5000;

  // Points awarded per staff per month
  const monthly = {};
  for (const e of ledger) {
    if (e.status === 'reversed') continue;
    const month = new Date(e.created).toLocaleDateString('en-PH', { month: 'short', year: 'numeric' });
    const name = e.expand?.staff?.name || e.expand?.staff?.email || 'Unknown';
    monthly[month] = monthly[month] || {};
    monthly[month][name] = (monthly[month][name] || 0) + e.points;
  }
  const months = Object.keys(monthly).sort((a, b) => new Date(b) - new Date(a));

  // Outstanding peso liability = active earned points not yet paid out
  const earnedByStaff = {};
  for (const e of ledger) {
    if (e.status === 'reversed') continue;
    earnedByStaff[e.staff] = (earnedByStaff[e.staff] || 0) + e.points;
  }
  const paidOrPendingByStaff = {};
  for (const r of redemptions) {
    if (r.status === 'rejected') continue;
    paidOrPendingByStaff[r.staff] = (paidOrPendingByStaff[r.staff] || 0) + r.points_used;
  }
  let totalOutstandingPoints = 0;
  for (const staffId of Object.keys(earnedByStaff)) {
    const outstanding = earnedByStaff[staffId] - (paidOrPendingByStaff[staffId] || 0);
    if (outstanding > 0) totalOutstandingPoints += outstanding;
  }

  return (
    <div className="space-y-6">
      <div className="bg-white rounded-[32px] border border-gray-100 shadow-sm p-6">
        <div className="flex items-center gap-2 text-gray-800 mb-2">
          <SafeIcon icon={FiTrendingUp} />
          <h3 className="font-black uppercase text-xs tracking-widest">Outstanding Peso Liability</h3>
        </div>
        <p className="text-2xl font-black text-gray-900">{peso(totalOutstandingPoints * pesoPerPoint)}</p>
        <p className="text-[10px] text-gray-400 font-bold mt-1">{totalOutstandingPoints} pts earned but not yet redeemed or paid out</p>
      </div>

      <div className="bg-white rounded-[32px] border border-gray-100 shadow-sm p-6">
        <h3 className="text-[9px] font-black text-gray-400 uppercase tracking-widest mb-4">Points Awarded Per Staff, Per Month</h3>
        {months.length === 0 ? (
          <p className="text-[10px] font-black uppercase tracking-widest text-gray-400 text-center py-6">No data yet.</p>
        ) : (
          <div className="space-y-5">
            {months.map((month) => (
              <div key={month}>
                <div className="text-[10px] font-black text-gray-500 uppercase tracking-widest mb-2">{month}</div>
                <div className="space-y-1.5">
                  {Object.entries(monthly[month]).sort((a, b) => b[1] - a[1]).map(([name, pts]) => (
                    <div key={name} className="flex justify-between items-center bg-gray-50 rounded-lg px-3 py-2">
                      <span className="text-[11px] font-bold text-gray-700 uppercase">{name}</span>
                      <span className="text-[11px] font-black text-blue-700">{pts} pts</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
};

// ---------- Rules ----------
const RulesTab = ({ rules, onChange }) => {
  const [eventType, setEventType] = useState('');
  const [defaultPoints, setDefaultPoints] = useState('');
  const [error, setError] = useState('');

  const handleAdd = async (e) => {
    e.preventDefault();
    setError('');
    if (!eventType || !defaultPoints) return;
    try {
      await pb.collection('reward_rules').create({
        event_type: eventType,
        default_points: Number(defaultPoints),
        active: true,
      });
      setEventType(''); setDefaultPoints('');
      onChange?.();
    } catch (err) {
      setError(err?.data?.message || err.message);
    }
  };

  const toggleActive = async (rule) => {
    await pb.collection('reward_rules').update(rule.id, { active: !rule.active });
    onChange?.();
  };

  const remove = async (id) => {
    if (!confirm('Delete this rule? Existing point entries referencing it will keep their history.')) return;
    await pb.collection('reward_rules').delete(id);
    onChange?.();
  };

  return (
    <div className="space-y-6">
      <form onSubmit={handleAdd} className="bg-white rounded-[32px] border border-gray-100 shadow-sm p-6 flex gap-3 flex-wrap items-end">
        <div className="flex-1 min-w-[180px]">
          <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Event Type</label>
          <input required value={eventType} onChange={(e) => setEventType(e.target.value)} placeholder="e.g. Referral Closed"
            className="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-200" />
        </div>
        <div className="w-32">
          <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Points</label>
          <input required type="number" step="0.5" value={defaultPoints} onChange={(e) => setDefaultPoints(e.target.value)}
            className="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-200" />
        </div>
        <button type="submit" className="bg-blue-700 text-white font-black text-[10px] uppercase tracking-widest px-5 py-3 rounded-xl flex items-center gap-2">
          <SafeIcon icon={FiPlus} /> Add
        </button>
      </form>
      {error && <div className="text-[10px] font-black text-red-600 uppercase bg-red-50 border border-red-100 rounded-xl px-4 py-3">{error}</div>}

      <div className="bg-white rounded-[32px] border border-gray-100 shadow-sm divide-y divide-gray-50 overflow-hidden">
        {rules.map((rule) => (
          <div key={rule.id} className="p-5 flex items-center justify-between gap-4">
            <div>
              <span className="font-black text-gray-900 uppercase text-sm">{rule.event_type}</span>
              <span className="text-[10px] text-gray-400 font-bold ml-2">+{rule.default_points} pts</span>
              {!rule.active && <span className="text-[8px] ml-2 px-2 py-0.5 rounded-full font-black uppercase bg-gray-100 text-gray-500">Inactive</span>}
            </div>
            <div className="flex gap-2">
              <button onClick={() => toggleActive(rule)} className="px-3 py-2 rounded-xl bg-gray-50 text-gray-500 border text-[9px] font-black uppercase">
                {rule.active ? 'Deactivate' : 'Activate'}
              </button>
              <button onClick={() => remove(rule.id)} className="p-2.5 rounded-xl bg-red-50 text-red-500 border border-red-100">
                <SafeIcon icon={FiTrash2} />
              </button>
            </div>
          </div>
        ))}
        {rules.length === 0 && (
          <div className="p-10 text-center text-[10px] font-black uppercase tracking-widest text-gray-400">No rules yet.</div>
        )}
      </div>
    </div>
  );
};

// ---------- Settings ----------
const SettingsTab = ({ settings, onChange }) => {
  const [pesoPerPoint, setPesoPerPoint] = useState(settings?.peso_per_point || 5000);
  const [bronze, setBronze] = useState(settings?.bronze_threshold ?? 5);
  const [silver, setSilver] = useState(settings?.silver_threshold ?? 15);
  const [gold, setGold] = useState(settings?.gold_threshold ?? 30);
  const [soldWeight, setSoldWeight] = useState(settings?.units_sold_weight ?? 5);
  const [saving, setSaving] = useState(false);
  const [saved, setSaved] = useState(false);

  useEffect(() => {
    setPesoPerPoint(settings?.peso_per_point || 5000);
    setBronze(settings?.bronze_threshold ?? 5);
    setSilver(settings?.silver_threshold ?? 15);
    setGold(settings?.gold_threshold ?? 30);
    setSoldWeight(settings?.units_sold_weight ?? 5);
  }, [settings]);

  const handleSave = async (e) => {
    e.preventDefault();
    setSaving(true);
    setSaved(false);
    const payload = {
      peso_per_point: Number(pesoPerPoint),
      bronze_threshold: Number(bronze),
      silver_threshold: Number(silver),
      gold_threshold: Number(gold),
      units_sold_weight: Number(soldWeight),
    };
    try {
      if (settings?.id) {
        await pb.collection('reward_settings').update(settings.id, payload);
      } else {
        await pb.collection('reward_settings').create({ ...payload, active: true });
      }
      setSaved(true);
      onChange?.();
    } finally {
      setSaving(false);
    }
  };

  return (
    <form onSubmit={handleSave} className="bg-white rounded-[32px] border border-gray-100 shadow-sm p-6 max-w-md space-y-6">
      <div>
        <div className="flex items-center gap-2 text-gray-800 mb-3">
          <SafeIcon icon={FiSettings} />
          <h3 className="font-black uppercase text-xs tracking-widest">Point Value</h3>
        </div>
        <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">1 Point =</label>
        <div className="flex items-center gap-2">
          <span className="text-gray-500 font-black">₱</span>
          <input type="number" value={pesoPerPoint} onChange={(e) => setPesoPerPoint(e.target.value)}
            className="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-200" />
        </div>
      </div>

      <div>
        <h3 className="font-black uppercase text-xs tracking-widest text-gray-800 mb-3">Leaderboard Tiers</h3>
        <p className="text-[10px] text-gray-400 font-bold mb-3">Weighted score = points earned + (units sold × weight)</p>
        <div className="grid grid-cols-2 gap-3">
          <div>
            <label className="block text-[9px] font-black text-orange-600 uppercase tracking-widest mb-1">Bronze at</label>
            <input type="number" value={bronze} onChange={(e) => setBronze(e.target.value)}
              className="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none" />
          </div>
          <div>
            <label className="block text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Silver at</label>
            <input type="number" value={silver} onChange={(e) => setSilver(e.target.value)}
              className="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none" />
          </div>
          <div>
            <label className="block text-[9px] font-black text-amber-600 uppercase tracking-widest mb-1">Gold at</label>
            <input type="number" value={gold} onChange={(e) => setGold(e.target.value)}
              className="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none" />
          </div>
          <div>
            <label className="block text-[9px] font-black text-gray-500 uppercase tracking-widest mb-1">Units Sold Weight</label>
            <input type="number" value={soldWeight} onChange={(e) => setSoldWeight(e.target.value)}
              className="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none" />
          </div>
        </div>
      </div>

      {saved && <div className="text-[10px] font-black text-green-600 uppercase bg-green-50 border border-green-100 rounded-xl px-4 py-3">Saved.</div>}
      <button type="submit" disabled={saving}
        className="w-full bg-blue-700 text-white font-black text-[10px] uppercase tracking-widest py-3 rounded-xl disabled:opacity-60">
        {saving ? 'Saving…' : 'Save'}
      </button>
    </form>
  );
};

export default RewardsModule;
