import React, { useEffect, useState } from 'react';
import pb from '../supabase/supabase';
import { FiUserPlus, FiTrash2, FiShield, FiUser, FiEdit2, FiKey } from 'react-icons/fi';
import SafeIcon from '../common/SafeIcon';

const VIEW_OPTIONS = [
  ['leads', 'Leads'], ['registry', 'Quotes'], ['calendar', 'CRM'],
  ['call-log', 'Calls'], ['follow-ups', 'Follows'], ['price-list', 'Price'],
  ['sold', 'Sold'], ['shipments', 'Shipments'], ['reports', 'Reports'],
  ['applicants', 'Hiring'], ['jobs', 'Jobs'], ['weekly-tasks', 'Weekly'],
  ['leaderboard', 'Leaderboard'], ['promo-units', 'Promo Units'],
];

function genPassword() {
  return Math.random().toString(36).slice(-6) + Math.random().toString(36).slice(-4).toUpperCase();
}

const emptyForm = { name: '', email: '', allowed_views: VIEW_OPTIONS.map(v => v[0]) };

const StaffModule = () => {
  const [staff, setStaff] = useState([]);
  const [loading, setLoading] = useState(true);
  const [mode, setMode] = useState('list'); // 'list' | 'create' | 'edit'
  const [editingId, setEditingId] = useState(null);
  const [form, setForm] = useState(emptyForm);
  const [error, setError] = useState('');
  const [tempPassword, setTempPassword] = useState(null);
  const [resetFor, setResetFor] = useState(null); // { id, name, password } — shown after a successful reset
  const [resettingMember, setResettingMember] = useState(null); // member currently being reset
  const [resetPasswordInput, setResetPasswordInput] = useState('');
  const [resetError, setResetError] = useState('');
  const [confirmDeleteId, setConfirmDeleteId] = useState(null);
  const currentUserId = pb.authStore.model?.id;

  const load = async () => {
    setLoading(true);
    try {
      const records = await pb.collection('users').getFullList({ sort: 'name' });
      setStaff(records);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => { load(); }, []);

  const toggleView = (key) => {
    setForm(f => ({
      ...f,
      allowed_views: f.allowed_views.includes(key)
        ? f.allowed_views.filter(v => v !== key)
        : [...f.allowed_views, key],
    }));
  };

  const startCreate = () => { setMode('create'); setForm(emptyForm); setError(''); setTempPassword(null); };
  const startEdit = (member) => {
    setMode('edit');
    setEditingId(member.id);
    setForm({
      name: member.name || '',
      email: member.email || '',
      allowed_views: member.allowed_views?.length ? member.allowed_views : VIEW_OPTIONS.map(v => v[0]),
    });
    setError('');
  };
  const cancelForm = () => { setMode('list'); setEditingId(null); setForm(emptyForm); setError(''); setTempPassword(null); load(); };

  const handleCreate = async (e) => {
    e.preventDefault();
    setError('');
    try {
      const password = genPassword();
      await pb.collection('users').create({
        name: form.name,
        email: form.email,
        role: 'staff',
        active: true,
        allowed_views: form.allowed_views,
        password,
        passwordConfirm: password,
        emailVisibility: true,
        verified: true,
      });
      setTempPassword(password);
    } catch (err) {
      setError(err?.data?.message || err.message || 'Failed to create account.');
    }
  };

  const handleUpdate = async (e) => {
    e.preventDefault();
    setError('');
    try {
      await pb.collection('users').update(editingId, {
        name: form.name,
        email: form.email,
        allowed_views: form.allowed_views,
      });
      cancelForm();
    } catch (err) {
      setError(err?.data?.message || err.message || 'Failed to update account.');
    }
  };

  const toggleActive = async (member) => {
    await pb.collection('users').update(member.id, { active: !member.active });
    load();
  };

  const handleDelete = async (id) => {
    await pb.collection('users').delete(id);
    setConfirmDeleteId(null);
    load();
  };

  const startReset = (member) => {
    setResettingMember(member);
    setResetPasswordInput(genPassword());
    setResetError('');
    setResetFor(null);
  };

  const cancelReset = () => {
    setResettingMember(null);
    setResetPasswordInput('');
    setResetError('');
  };

  const confirmReset = async () => {
    if (resetPasswordInput.length < 8) {
      setResetError('Password must be at least 8 characters.');
      return;
    }
    try {
      await pb.collection('users').update(resettingMember.id, {
        password: resetPasswordInput,
        passwordConfirm: resetPasswordInput,
      });
      setResetFor({ id: resettingMember.id, name: resettingMember.name || resettingMember.email, password: resetPasswordInput });
      setResettingMember(null);
      setResetPasswordInput('');
      setResetError('');
    } catch (err) {
      setResetError(err?.data?.message || err.message || 'Password reset failed.');
    }
  };

  const renderForm = (onSubmit, submitLabel) => (
    <div className="bg-white rounded-[32px] border border-gray-100 shadow-sm p-6 mb-6">
      {tempPassword ? (
        <div className="space-y-4">
          <h3 className="font-black text-gray-800 uppercase text-xs tracking-widest">Account created</h3>
          <p className="text-[11px] text-gray-500 font-bold">
            Share this temporary password with {form.name}. It won't be shown again.
          </p>
          <div className="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 font-mono text-blue-700 text-lg text-center">
            {tempPassword}
          </div>
          <button onClick={cancelForm} className="w-full bg-blue-700 text-white font-black text-[10px] uppercase tracking-widest py-3 rounded-xl">Done</button>
        </div>
      ) : (
        <form onSubmit={onSubmit} className="space-y-4">
          <div>
            <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Name</label>
            <input required value={form.name} onChange={e => setForm({ ...form, name: e.target.value })}
              className="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-200" />
          </div>
          <div>
            <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-1">Email</label>
            <input required type="email" value={form.email} onChange={e => setForm({ ...form, email: e.target.value })}
              className="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-200" />
          </div>
          <div>
            <label className="block text-[9px] font-black text-gray-400 uppercase tracking-widest mb-2">Page Access</label>
            <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
              {VIEW_OPTIONS.map(([key, label]) => (
                <label key={key} className="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-[10px] font-bold uppercase cursor-pointer">
                  <input type="checkbox" checked={form.allowed_views.includes(key)} onChange={() => toggleView(key)} />
                  {label}
                </label>
              ))}
            </div>
          </div>
          {error && <div className="text-[10px] font-black text-red-600 uppercase bg-red-50 border border-red-100 rounded-xl px-4 py-3">{error}</div>}
          <div className="flex gap-3">
            <button type="submit" className="flex-1 bg-blue-700 text-white font-black text-[10px] uppercase tracking-widest py-3 rounded-xl">{submitLabel}</button>
            <button type="button" onClick={cancelForm} className="flex-1 bg-gray-100 text-gray-600 font-black text-[10px] uppercase tracking-widest py-3 rounded-xl">Cancel</button>
          </div>
        </form>
      )}
    </div>
  );

  return (
    <div className="max-w-3xl mx-auto">
      <div className="flex items-center justify-between mb-6">
        <h2 className="font-black text-gray-800 flex items-center gap-3 uppercase text-xs tracking-widest">
          <div className="w-1 h-4 bg-blue-600 rounded-full" /> Staff Accounts
        </h2>
        {mode === 'list' && (
          <button onClick={startCreate} className="bg-blue-700 text-white font-black text-[10px] uppercase tracking-widest px-4 py-2.5 rounded-xl flex items-center gap-2">
            <SafeIcon icon={FiUserPlus} /> Add Staff
          </button>
        )}
      </div>

      {mode === 'create' && renderForm(handleCreate, 'Create')}
      {mode === 'edit' && renderForm(handleUpdate, 'Save Changes')}

      {resetFor && (
        <div className="bg-amber-50 border border-amber-200 rounded-[24px] p-5 mb-6 flex items-center justify-between gap-4">
          <div>
            <div className="text-[10px] font-black text-amber-700 uppercase tracking-widest">New password for {resetFor.name}</div>
            <div className="font-mono text-amber-900 text-lg mt-1">{resetFor.password}</div>
          </div>
          <button onClick={() => setResetFor(null)} className="text-[9px] font-black text-amber-700 uppercase bg-white border border-amber-200 px-3 py-2 rounded-lg">Dismiss</button>
        </div>
      )}

      {mode === 'list' && (
        <div className="bg-white rounded-[32px] border border-gray-100 shadow-sm divide-y divide-gray-50 overflow-hidden">
          {loading ? (
            <div className="p-10 text-center text-[10px] font-black uppercase tracking-widest text-gray-400">Loading…</div>
          ) : staff.map(member => {
            const isAdminRole = member.role === 'admin';
            const displayName = member.name?.trim() || '(No name set)';
            const displayEmail = member.email?.trim() || '(Email hidden)';
            return (
              <div key={member.id} className="p-5 flex items-center justify-between gap-4 flex-wrap">
                <div className="flex items-center gap-3">
                  <div className={`w-9 h-9 rounded-full flex items-center justify-center shrink-0 ${isAdminRole ? 'bg-blue-50 text-blue-600' : 'bg-gray-50 text-gray-400'}`}>
                    <SafeIcon icon={isAdminRole ? FiShield : FiUser} />
                  </div>
                  <div>
                    <div className="flex items-center gap-2 flex-wrap">
                      <span className="font-black text-gray-900 uppercase text-sm">{displayName}</span>
                      <span className={`text-[8px] px-2 py-0.5 rounded-full font-black uppercase border ${isAdminRole ? 'bg-blue-50 text-blue-600 border-blue-100' : 'bg-gray-50 text-gray-500 border-gray-200'}`}>
                        {isAdminRole ? 'Admin' : 'Staff'}
                      </span>
                      {!member.active && (
                        <span className="text-[8px] px-2 py-0.5 rounded-full font-black uppercase bg-red-50 text-red-600 border border-red-100">Inactive</span>
                      )}
                    </div>
                    <div className="text-[10px] text-gray-400 font-bold uppercase mt-0.5">{displayEmail}</div>
                  </div>
                </div>
                <div className="flex items-center gap-2 shrink-0">
                  <button onClick={() => startEdit(member)} className="p-2.5 rounded-xl bg-gray-50 text-gray-500 border" title="Edit name/email/page access">
                    <SafeIcon icon={FiEdit2} />
                  </button>
                  <button onClick={() => startReset(member)} className="p-2.5 rounded-xl bg-gray-50 text-gray-500 border" title="Reset password">
                    <SafeIcon icon={FiKey} />
                  </button>
                  <button onClick={() => toggleActive(member)} disabled={member.id === currentUserId}
                    className="px-3 py-2.5 rounded-xl bg-gray-50 text-gray-500 border text-[9px] font-black uppercase disabled:opacity-30">
                    {member.active ? 'Deactivate' : 'Reactivate'}
                  </button>
                  {confirmDeleteId === member.id ? (
                    <div className="flex gap-1">
                      <button onClick={() => handleDelete(member.id)} className="px-3 py-2.5 rounded-xl bg-red-600 text-white text-[9px] font-black uppercase">Confirm</button>
                      <button onClick={() => setConfirmDeleteId(null)} className="px-3 py-2.5 rounded-xl bg-gray-100 text-gray-500 text-[9px] font-black uppercase">Cancel</button>
                    </div>
                  ) : (
                    <button onClick={() => setConfirmDeleteId(member.id)} disabled={member.id === currentUserId}
                      className="p-2.5 rounded-xl bg-red-50 text-red-500 border border-red-100 disabled:opacity-30">
                      <SafeIcon icon={FiTrash2} />
                    </button>
                  )}
                </div>
              </div>
            );
          })}
          {resettingMember && (
            <div className="p-5 bg-amber-50 border-t border-amber-100">
              <div className="text-[10px] font-black text-amber-700 uppercase tracking-widest mb-2">
                Set new password for {resettingMember.name || resettingMember.email}
              </div>
              <div className="flex flex-wrap gap-2 items-center">
                <input
                  type="text"
                  value={resetPasswordInput}
                  onChange={e => setResetPasswordInput(e.target.value)}
                  placeholder="Enter new password"
                  className="flex-1 min-w-[200px] px-4 py-2.5 bg-white border border-amber-200 rounded-xl text-sm font-mono outline-none focus:ring-2 focus:ring-amber-200"
                />
                <button type="button" onClick={() => setResetPasswordInput(genPassword())}
                  className="px-3 py-2.5 rounded-xl bg-white border border-amber-200 text-amber-700 text-[9px] font-black uppercase">
                  Generate
                </button>
                <button type="button" onClick={confirmReset}
                  className="px-4 py-2.5 rounded-xl bg-amber-600 text-white text-[9px] font-black uppercase">
                  Set Password
                </button>
                <button type="button" onClick={cancelReset}
                  className="px-4 py-2.5 rounded-xl bg-white border border-gray-200 text-gray-500 text-[9px] font-black uppercase">
                  Cancel
                </button>
              </div>
              <p className="text-[9px] text-amber-600 font-bold mt-1.5">Minimum 8 characters.</p>
              {resetError && <div className="text-[10px] font-black text-red-600 uppercase bg-red-50 border border-red-100 rounded-xl px-4 py-2 mt-2">{resetError}</div>}
            </div>
          )}
          {!loading && staff.length === 0 && (
            <div className="p-10 text-center text-[10px] font-black uppercase tracking-widest text-gray-400">No staff yet.</div>
          )}
        </div>
      )}
    </div>
  );
};

export default StaffModule;
